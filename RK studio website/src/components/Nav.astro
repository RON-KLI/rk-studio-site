---
const { current = 'home' } = Astro.props;
const items = [
  { id: 'artworks',    label: 'Artworks',    href: '/artworks/' },
  { id: 'exhibitions', label: 'Exhibitions', href: '/exhibitions/' },
  { id: 'about',       label: 'About',       href: '/about/' },
];
---
<div class="nav-wrap">
  <nav class="lg nav-pill">
    <a href="/" class="nav-mono" aria-label="Ron Klimovsky — home">
      <img src="/assets/logo.png" alt="Ron Klimovsky" />
    </a>
    <div class="nav-links">
      {items.map((it) => (
        <a href={it.href} class:list={['nav-link', { active: current === it.id }]}>{it.label}</a>
      ))}
    </div>
    <button type="button" class="nav-inquire press" data-open-inquire aria-label="Inquire">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
      <span class="nav-inq-label">Inquire</span>
    </button>
  </nav>
</div>

<style>
  .nav-wrap { position: sticky; top: 0; z-index: 80; padding: 20px 24px 0; display: flex; justify-content: center; pointer-events: none; }
  .nav-pill { pointer-events: auto; display: flex; align-items: center; gap: 22px; height: 58px; padding: 0 8px 0 18px; border-radius: 999px; max-width: 100%; }
  .nav-mono { display: flex; align-items: center; gap: 10px; background: transparent; border: 0; padding: 0; cursor: pointer; flex: 0 0 auto; }
  .nav-mono img { height: 22px; width: auto; display: block; }
  .nav-links { display: flex; gap: 4px; }
  .nav-link { font-family: var(--font-ui); font-size: 13px; font-weight: 500; color: var(--ink-2); padding: 8px 14px; border-radius: 999px; letter-spacing: -0.005em; white-space: nowrap; text-decoration: none; transition: all 220ms var(--ease-out); }
  .nav-link:hover { background: rgba(0,0,0,0.04); }
  .nav-link.active { background: var(--bone); box-shadow: var(--shadow-xs); color: var(--ink-1); }
  .nav-inquire { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px 9px 14px; border-radius: 999px; background: var(--ink-1); color: var(--bone); border: 0; font-size: 13px; font-weight: 500; font-family: var(--font-ui); flex: 0 0 auto; white-space: nowrap; }

  /* Tablet / small: let the pill hug its content and stay centered (no full-width gap) */
  @media (max-width: 640px) {
    .nav-wrap { padding: 12px 14px 0; }
    .nav-pill { gap: 12px; padding: 0 6px 0 14px; height: 52px; }
    .nav-links { gap: 2px; }
    .nav-link { padding: 8px 10px; font-size: 13px; }
    .nav-mono img { height: 20px; }
  }
  /* Phones: tighten, and make Inquire icon-only so everything fits one tidy pill */
  @media (max-width: 420px) {
    .nav-pill { gap: 6px; padding: 0 6px 0 12px; }
    .nav-links { gap: 0; }
    .nav-link { padding: 7px 8px; font-size: 12.5px; }
    .nav-inq-label { display: none; }
    .nav-inquire { padding: 9px 11px; }
  }
</style>
