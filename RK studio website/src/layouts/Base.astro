---
import '../styles/tokens.css';
import '../styles/app.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Modals from '../components/Modals.astro';
import { siteConfig } from '../siteConfig';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  image?: string;
}
const {
  title = 'Ron Klimovsky Studio — Visual artist · paintings, drawings & editions',
  description = 'Ron Klimovsky (ARC) is a multidisciplinary visual artist working mainly in the US. Current paintings and drawings, exhibitions, and a short studio biography. Inquiries welcome.',
  current = 'home',
  image = '/assets/logo.png',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.domain).href;
const ogImage = new URL(image, siteConfig.domain).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Ron Klimovsky" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#FBF6EC" />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Ron Klimovsky Studio" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/png" href="/assets/logo.png" />
  <link rel="apple-touch-icon" href="/assets/logo.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Ron Klimovsky',
    alternateName: 'ARC',
    jobTitle: 'Visual artist',
    description: 'Ron Klimovsky (ARC) is a multidisciplinary visual artist working mainly in the US.',
    url: siteConfig.domain + '/',
    email: siteConfig.email,
    image: ogImage,
    knowsAbout: ['Painting', 'Drawing', 'Printmaking', 'Contemporary art', 'Visual art'],
    worksFor: { '@type': 'Organization', name: 'Ron Klimovsky Studio', url: siteConfig.domain + '/' },
  })} />
</head>
<body>
  <div aria-hidden="true" class="page-wash"></div>
  <div id="app">
    <Nav current={current} />
    <main>
      <slot />
    </main>
    <Footer />
  </div>
  <Modals />
  <style is:global>
    .page-wash { position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background: radial-gradient(ellipse 110% 80% at 50% 0%, #FFFFFF 0%, transparent 60%),
                  linear-gradient(180deg, #FDFBF6 0%, #F7F1E6 55%, #F0E8D7 100%); }
    #app { position: relative; z-index: 1; min-height: 100vh; }
    main { position: relative; }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
    }
  </style>
</body>
</html>
