---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Ron Klimovsky Studio">
  <section style="max-width:680px;margin:0 auto;padding:120px 32px;text-align:center;">
    <div style="font-family:var(--font-mono);font-size:10.5px;color:var(--ink-3);letter-spacing:0.18em;text-transform:uppercase;">404</div>
    <h1 style="font-family:var(--font-display);font-size:clamp(40px,6vw,76px);font-weight:400;margin:12px 0 20px;letter-spacing:-0.03em;">This room is empty.</h1>
    <p style="font-size:17px;color:var(--ink-2);margin:0 0 32px;">The page you were looking for isn't here.</p>
    <a href="/" class="press" style="display:inline-block;padding:13px 22px;border-radius:999px;background:var(--ink-1);color:var(--bone);text-decoration:none;font-size:14px;font-weight:500;">Back to the studio</a>
  </section>
</Base>
