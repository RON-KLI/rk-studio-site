---
import Base from '../../layouts/Base.astro';
import Painting from '../../components/Painting.astro';
import { getExhibitions, displayDates } from '../../lib/content';

const exhibitions = await getExhibitions();
const featured = exhibitions.find((x) => x.data.featured) || exhibitions.find((x) => x.status !== 'Past') || exhibitions[0];
const filters = [['all', 'All'], ['upcoming', 'Upcoming'], ['on view', 'On view'], ['past', 'Past']];
---
<Base current="exhibitions" title="Exhibitions — Ron Klimovsky Studio" description="Upcoming, current and past exhibitions and events from Ron Klimovsky Studio.">
  <section class="exh">
    <div class="eyebrow">Exhibitions & events</div>
    <div class="exh-head">
      <h1 class="exh-h1">Calendar</h1>
      <p class="exh-sub">I hate social gatherings but they photograph well so see you soon.</p>
    </div>

    {featured && (
      <div class="lg-strong featured-show">
        <div aria-hidden="true" class="fs-glow"></div>
        <div class="fs-left">
          <span class="fs-pill"><span class="fs-pill-dot"></span>{featured.status === 'Past' ? 'Most recent' : featured.status === 'On view' ? 'On view now' : 'Next show'} · {displayDates(featured.data.startDate, featured.data.endDate).split('—')[0].trim()}</span>
          <h2 class="fs-title">{featured.data.title}</h2>
          <div class="fs-meta">{displayDates(featured.data.startDate, featured.data.endDate).toUpperCase()}<br />{featured.data.venue.toUpperCase()}<br />{featured.data.city.toUpperCase()}</div>
          <p class="fs-blurb">{featured.body}</p>
          {featured.data.rsvp && (
            <div class="fs-actions">
              <button type="button" class="btn-primary press" data-open-inquire data-work-title={`RSVP — ${featured.data.title}`}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg> RSVP
              </button>
            </div>
          )}
        </div>
        <div class="fs-right">
          <Painting image={featured.data.image} alt={featured.data.alt} title={featured.data.title} year={featured.data.startDate.getFullYear()} aspect="4/5" />
        </div>
      </div>
    )}

    <div class="exh-filters" data-filters>
      {filters.map(([id, label], i) => (
        <button type="button" class:list={['chip', { active: i === 0 }]} data-filter={id}>{label}</button>
      ))}
    </div>

    <div class="timeline" data-timeline>
      <div class="timeline-rail"></div>
      {exhibitions.map((x) => (
        <div class="show-row" data-status={x.status}>
          <div class="sr-year">
            <span>{x.data.startDate.getFullYear()}</span>
            <span class:list={['sr-dot', { onview: x.status === 'On view', upcoming: x.status === 'Upcoming' }]}></span>
          </div>
          <div class="sr-main">
            <div class="sr-title">{x.data.title}</div>
            <div class="sr-venue">{x.data.venue.toUpperCase()} · {x.data.city.toUpperCase()}</div>
            <p class="sr-blurb">{x.body}</p>
          </div>
          <div class="sr-status">
            <div class:list={['sr-badge', { past: x.status === 'Past' }]}>{x.status}</div>
            <div class="sr-dates">{displayDates(x.data.startDate, x.data.endDate)}</div>
          </div>
        </div>
      ))}
    </div>
    <div class="exh-empty" data-empty hidden>Nothing here, at the moment.</div>
  </section>
</Base>

<style>
  .exh { position: relative; padding: 64px 32px 144px; max-width: 1280px; margin: 0 auto; }
  .eyebrow { font-family: var(--font-mono); font-size: 10.5px; color: var(--ink-3); letter-spacing: 0.18em; text-transform: uppercase; }
  .exh-head { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 12px; gap: 32px; flex-wrap: wrap; margin-bottom: 48px; }
  .exh-h1 { font-family: var(--font-display); font-size: clamp(40px, 5vw, 76px); line-height: 1.0; letter-spacing: -0.03em; margin: 0; font-weight: 400; }
  .exh-sub { font-size: 16px; color: var(--ink-3); max-width: 32ch; margin: 0; line-height: 1.55; }
  .featured-show { position: relative; border-radius: 32px; padding: 32px; display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; overflow: hidden; }
  .fs-glow { position: absolute; right: -100px; top: -100px; width: 420px; height: 420px; border-radius: 50%; background: radial-gradient(circle at center, var(--bone) 0%, var(--paper-2) 40%, transparent 70%); filter: blur(80px); opacity: 0.9; pointer-events: none; }
  .fs-left { position: relative; }
  .fs-pill { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px 6px 10px; border-radius: 999px; background: var(--bone); box-shadow: inset 0 0 0 1px var(--mist); font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 24px; }
  .fs-pill-dot { width: 6px; height: 6px; border-radius: 999px; background: var(--accent-3, var(--sunrise)); box-shadow: 0 0 0 4px rgba(255,123,60,0.25); }
  .fs-title { font-family: var(--font-display); font-style: italic; font-size: clamp(32px, 4vw, 56px); line-height: 1.0; letter-spacing: -0.025em; margin: 0; font-weight: 400; color: var(--ink-1); }
  .fs-meta { font-family: var(--font-mono); font-size: 12px; color: var(--ink-3); letter-spacing: 0.06em; margin-top: 16px; line-height: 1.8; }
  .fs-blurb { margin-top: 24px; font-size: 15px; color: var(--ink-2); line-height: 1.6; max-width: 44ch; }
  .fs-actions { display: flex; gap: 10px; margin-top: 28px; }
  .btn-primary { padding: 13px 22px; border-radius: 999px; background: var(--ink-1); color: var(--bone); border: 0; font-size: 14px; font-weight: 500; font-family: var(--font-ui); display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
  .exh-filters { display: flex; gap: 6px; margin-top: 80px; margin-bottom: 28px; flex-wrap: wrap; }
  .chip { padding: 8px 14px; border-radius: 999px; border: 0; cursor: pointer; font-family: var(--font-ui); font-size: 13px; font-weight: 500; background: var(--bone); color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--mist); transition: all 240ms var(--ease-out); }
  .chip.active { background: var(--ink-1); color: var(--bone); box-shadow: var(--shadow-sm); }
  .timeline { position: relative; }
  .timeline-rail { position: absolute; left: 80px; top: 28px; bottom: 28px; width: 1px; background: var(--mist); }
  .show-row { position: relative; display: grid; grid-template-columns: 120px 1fr 200px; gap: 24px; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--mist); }
  .sr-year { display: flex; align-items: center; gap: 18px; position: relative; }
  .sr-year span:first-child { font-family: var(--font-mono); font-size: 13px; color: var(--ink-2); letter-spacing: 0.04em; }
  .sr-dot { position: absolute; left: 76px; top: 50%; transform: translateY(-50%); width: 10px; height: 10px; border-radius: 999px; background: var(--ink-4); border: 2px solid var(--paper); z-index: 1; }
  .sr-dot.onview { background: var(--status-positive); box-shadow: 0 0 0 4px rgba(138,154,91,0.18); }
  .sr-dot.upcoming { background: var(--accent-3, var(--sunrise)); box-shadow: 0 0 0 4px rgba(255,123,60,0.25); }
  .sr-main { padding-left: 24px; }
  .sr-title { font-family: var(--font-display); font-style: italic; font-size: 24px; color: var(--ink-1); line-height: 1.15; letter-spacing: -0.015em; }
  .sr-venue { font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); letter-spacing: 0.06em; margin-top: 6px; }
  .sr-blurb { margin: 10px 0 0; font-size: 14px; color: var(--ink-2); line-height: 1.55; max-width: 60ch; }
  .sr-status { text-align: right; }
  .sr-badge { display: inline-flex; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 500; color: var(--ink-1); padding: 5px 11px; border-radius: 999px; background: var(--bone); box-shadow: inset 0 0 0 1px var(--mist); }
  .sr-badge.past { background: var(--paper-2); color: var(--ink-3); }
  .sr-dates { font-family: var(--font-mono); font-size: 10.5px; color: var(--ink-3); letter-spacing: 0.04em; margin-top: 10px; line-height: 1.5; }
  .exh-empty { padding: 60px 0; text-align: center; color: var(--ink-3); font-style: italic; font-family: var(--font-display); font-size: 20px; }
  @media (max-width: 760px) {
    .featured-show { grid-template-columns: 1fr; }
    .show-row { grid-template-columns: 60px 1fr; gap: 14px; }
    .timeline-rail, .sr-dot { display: none; }
    .sr-main { padding-left: 0; }
    .sr-status { grid-column: 1 / -1; text-align: left; display: flex; gap: 14px; align-items: center; }
    .sr-dates { margin-top: 0; }
  }
  @media (max-width: 520px) { .exh { padding: 40px 18px 96px; } .featured-show { padding: 22px; } }
</style>

<script>
  const filters = document.querySelector('[data-filters]');
  const timeline = document.querySelector('[data-timeline]');
  const empty = document.querySelector('[data-empty]');
  if (filters && timeline) {
    filters.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-filter]') as HTMLElement | null;
      if (!btn) return;
      filters.querySelectorAll('.chip').forEach((c) => c.classList.remove('active'));
      btn.classList.add('active');
      const f = (btn.dataset.filter || 'all').toLowerCase();
      let shown = 0;
      timeline.querySelectorAll('.show-row').forEach((row) => {
        const el = row as HTMLElement;
        const status = (el.dataset.status || '').toLowerCase();
        const show = f === 'all' || status === f;
        el.style.display = show ? '' : 'none';
        if (show) shown++;
      });
      if (empty) (empty as HTMLElement).hidden = shown !== 0;
    });
  }
</script>
