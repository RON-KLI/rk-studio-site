---
import Base from '../layouts/Base.astro';
import StatusPill from '../components/StatusPill.astro';
import Painting from '../components/Painting.astro';
import { getArtworks } from '../lib/content';
import { getEntry } from 'astro:content';

const artworks = await getArtworks();
const featured = artworks.find((w) => w.data.featured) || artworks[0];
const home = await getEntry('site', 'home');
const heroTitle = home?.data.heroTitle || 'Creating Art...';
const heroSubtitle = home?.data.heroSubtitle || 'I could explain but its better if you just look for yourself.';
---
<Base current="home">
  <section class="hero">
    <div aria-hidden="true" class="hero-glow"></div>
    <div class="hero-status"><StatusPill /></div>
    <h1 class="hero-h1">{heroTitle}</h1>
    <p class="hero-sub">{heroSubtitle}</p>
    <div class="hero-cta">
      <a href="/artworks/" class="btn-primary press">See what's on view</a>
      <button type="button" class="btn-ghost press" data-open-signup>Sign up for updates</button>
    </div>
    {featured && (
      <div class="hero-featured">
        <div class="lift featured-card">
          <a href={`/artworks/${featured.slug}/`} aria-label={featured.data.title}>
            <Painting image={featured.data.image} alt={featured.data.alt} title={featured.data.title} year={featured.data.year} aspect="5/6" />
          </a>
          <div class="lg-strong featured-caption">
            <span class="fc-title">{featured.data.title}</span>
            <span class="fc-div"></span>
            <span class="fc-meta">{featured.data.medium.toUpperCase()} · {featured.data.year}</span>
          </div>
        </div>
      </div>
    )}
  </section>
</Base>

<style>
  .hero { position: relative; padding: 72px 24px 120px; max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .hero-glow { position: absolute; top: -40px; left: 50%; transform: translateX(-50%); width: 820px; height: 600px; max-width: 100%; border-radius: 50%; background: radial-gradient(ellipse at center, var(--bone) 0%, var(--paper-2) 40%, transparent 70%); filter: blur(80px); opacity: 0.9; pointer-events: none; z-index: 0; }
  .hero-status { position: relative; z-index: 1; margin: 12px 0 32px; }
  .hero-h1 { position: relative; z-index: 1; font-family: var(--font-display); font-size: clamp(56px, 8vw, 128px); line-height: 1.0; letter-spacing: -0.035em; margin: 0; font-weight: 400; max-width: 16ch; text-wrap: balance; color: var(--ink-1); }
  .hero-sub { position: relative; z-index: 1; font-size: 18px; color: var(--ink-2); max-width: 44ch; margin-top: 44px; line-height: 1.55; }
  .hero-cta { position: relative; z-index: 1; display: flex; gap: 10px; margin-top: 36px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { padding: 13px 22px; border-radius: 999px; background: var(--ink-1); color: var(--bone); border: 0; font-size: 14px; font-weight: 500; font-family: var(--font-ui); text-decoration: none; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
  .btn-ghost { padding: 13px 22px; border-radius: 999px; background: transparent; color: var(--ink-1); border: 1px solid var(--mist); font-size: 14px; font-weight: 500; font-family: var(--font-ui); cursor: pointer; }
  .hero-featured { position: relative; z-index: 1; margin-top: 72px; width: min(720px, 90%); display: flex; justify-content: center; }
  .featured-card { position: relative; width: 100%; max-width: 640px; }
  .featured-card a { display: block; }
  .featured-caption { position: absolute; left: 50%; bottom: -28px; transform: translateX(-50%); padding: 12px 18px 12px 16px; border-radius: 999px; display: flex; align-items: center; gap: 14px; white-space: nowrap; box-shadow: var(--shadow-lg); }
  .fc-title { font-family: var(--font-display); font-style: italic; font-size: 17px; color: var(--ink-1); }
  .fc-div { width: 1px; height: 14px; background: var(--mist); }
  .fc-meta { font-family: var(--font-mono); font-size: 10.5px; color: var(--ink-3); letter-spacing: 0.06em; }
  @media (max-width: 520px) { .featured-caption { flex-direction: column; gap: 4px; white-space: normal; text-align: center; border-radius: 22px; } .fc-div { display: none; } }
</style>
